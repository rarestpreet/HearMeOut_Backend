# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hearmeout
DB_USER=root
DB_PASS=your_mysql_password

# JWT (generate a secure random key)
SECRET_KEY=replace_with_a_secure_random_32+_character_secret

# Spring
SPRING_ACTIVE_PROFILE=dev

# Gmail SMTP
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

# Server
PORT=8080

# Email that should receive the ADMIN role on account verification
ADMIN_MAIL=admin@example.com